---
import { t, currentLanguage } from '../i18n';

interface ChapterMeta {
  order_idx: number;
  module: string;
  title: string;
  status: string;
}
interface Props {
  current: number;
}
const { current } = Astro.props;

let chapters: ChapterMeta[] = [];
try {
  const data = await import('../content/textbook/curriculum.json');
  chapters = (data.default || data).chapters || [];
} catch (e) {
  chapters = [];
}

const byModule = new Map<string, ChapterMeta[]>();
for (const ch of chapters) {
  if (!byModule.has(ch.module)) byModule.set(ch.module, []);
  byModule.get(ch.module)!.push(ch);
}

const total = chapters.length;
const done = chapters.filter(c => c.status === 'synthesized').length;
---
<aside class="textbook-nav">
  <div class="nav-header">
    <a class="nav-title" href="/textbook/">{t.nav_textbook}</a>
    <div class="nav-progress">
      <div class="nav-progress-track">
        <div class="nav-progress-fill" style={`width: ${total ? (done * 100 / total) : 0}%`}></div>
      </div>
      <div class="nav-progress-text">{done} / {total} {currentLanguage === 'en' ? 'chapters' : '章'}</div>
    </div>
  </div>

  {Array.from(byModule.entries()).map(([module, items], moduleIdx) => (
    <section class="nav-module" data-module-idx={(moduleIdx % 5) + 1}>
      <h4 class="nav-module-title">
        <span class="nav-module-dot"></span>
        {module}
      </h4>
      <ol class="nav-chapters">
        {items.map(ch => (
          <li class:list={[
            'nav-chapter',
            ch.order_idx === current ? 'current' : '',
            ch.status === 'synthesized' ? 'done' : 'planned',
          ]}>
            <span class="nav-chapter-num">{ch.order_idx}</span>
            {ch.status === 'synthesized' ? (
              <a class="nav-chapter-link" href={`/textbook/${ch.order_idx}/`}>{ch.title}</a>
            ) : (
              <span class="nav-chapter-text">{ch.title}</span>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}
</aside>

<style>
  .textbook-nav {
    font-size: 0.93em;
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding-right: 1rem;
    border-right: 1px solid var(--border);
  }
  .textbook-nav::-webkit-scrollbar { width: 6px; }
  .textbook-nav::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 3px; }

  .nav-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.2rem;
  }
  .nav-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.4em;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
    margin-bottom: 0.6rem;
  }
  .nav-title:hover { color: var(--accent); }
  .nav-progress-track {
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .nav-progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 0.3s ease;
  }
  .nav-progress-text {
    font-size: 0.78em;
    color: var(--text-muted);
    margin-top: 0.4rem;
    font-variant-numeric: tabular-nums;
  }

  .nav-module { margin-block: 1.3rem; }
  .nav-module-title {
    font-size: 0.74em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    font-weight: 600;
    margin-bottom: 0.6rem;
    padding-block: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-module-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--module-accent, var(--accent));
    display: inline-block;
    flex-shrink: 0;
  }
  .nav-chapters {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-chapter {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0 0.35rem 0.55rem;
    margin: 0.1rem 0;
    border-left: 2px solid transparent;
    line-height: 1.4;
    border-radius: 0 4px 4px 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .nav-chapter-num {
    font-family: var(--font-mono);
    font-size: 0.78em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .nav-chapter-link {
    color: var(--text);
    text-decoration: none;
    font-size: 0.92em;
  }
  .nav-chapter-link:hover { color: var(--module-accent, var(--accent)); }
  .nav-chapter-text {
    color: var(--text-faint);
    font-size: 0.92em;
    font-style: italic;
  }

  .nav-chapter.current {
    border-left-color: var(--module-accent, var(--accent));
    background: var(--module-accent-soft, var(--accent-soft));
  }
  .nav-chapter.current .nav-chapter-link { color: var(--module-accent, var(--accent)); font-weight: 600; }
  .nav-chapter.current .nav-chapter-num { color: var(--module-accent, var(--accent)); font-weight: 600; }

  .nav-chapter.planned { opacity: 0.55; }

  @media (max-width: 900px) {
    .textbook-nav {
      display: none;
    }
    .mobile-drawer-slot .textbook-nav {
      display: block;
      position: relative;
      top: 0;
      max-height: none;
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
