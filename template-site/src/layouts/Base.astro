---
import '../styles/global.css';
import { t, currentLanguage } from '../i18n';

interface Props {
  title: string;
}
const { title } = Astro.props;
const htmlLang = currentLanguage === 'en' ? 'en' : 'zh-CN';
const base = import.meta.env.BASE_URL; // e.g. '/video-to-notebook/' on Pages, '/' locally
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>{title} · video-to-notebook</title>
  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+Pro:wght@400;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
  <script is:inline>
    (function () {
      try {
        const stored = localStorage.getItem('cm-theme');
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : sysDark;
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.toggle('light', !isDark);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <a class="site-logo" href={base} aria-label="video-to-notebook home">
      <svg class="site-logo-glyph" viewBox="0 0 64 64" width="28" height="28"
           aria-hidden="true" focusable="false"
           fill="none" stroke="currentColor" stroke-width="2.8"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M 32 17 C 24 13 14 13 6 15 L 6 49 C 14 47 24 47 32 51 Z"/>
        <path d="M 32 17 C 40 13 50 13 58 15 L 58 49 C 50 47 40 47 32 51 Z"/>
        <line x1="32" y1="14" x2="32" y2="19"/>
        <line x1="32" y1="49" x2="32" y2="54"/>
        <path d="M 15 25 L 15 39 L 26 32 Z" fill="currentColor" stroke="none"/>
        <line x1="38" y1="26" x2="53" y2="27" stroke-width="2.4"/>
        <line x1="38" y1="32" x2="53" y2="33" stroke-width="2.4"/>
        <line x1="38" y1="38" x2="48" y2="39" stroke-width="2.4"/>
      </svg>
      <span class="site-logo-text">video<span class="site-logo-sep">-to-</span>notebook</span>
    </a>
    <nav class="site-nav" aria-label="main navigation">
      <a href={`${base}textbook/`}>{t.nav_textbook}</a>
      <a href={`${base}courses/`}>{t.nav_courses}</a>
      <a href={`${base}concepts/`}>{t.nav_concepts}</a>
      <a href={`${base}about/`}>{t.nav_about}</a>
    </nav>
    <div class="site-actions">
      <div id="pagefind-search" class="site-search"></div>
      <button
        class="lang-toggle"
        id="lang-toggle"
        data-current-lang={currentLanguage}
        aria-label={currentLanguage === 'en' ? 'switch to Chinese' : '切换到英文'}
        title={currentLanguage === 'en' ? 'switch to 中文' : '切换到 English'}
      >
        <span class="lang-toggle-label">{currentLanguage === 'en' ? '中' : 'EN'}</span>
      </button>
      <button class="theme-toggle" id="theme-toggle" aria-label={t.nav_toggle_theme} title={t.nav_toggle_theme}>
        <svg class="icon-light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="icon-dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="nav-mobile-toggle" id="nav-mobile-toggle" aria-label="open navigation" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </header>
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <div class="mobile-drawer-backdrop" data-drawer-close></div>
    <aside class="mobile-drawer-panel">
      <button class="mobile-drawer-close" data-drawer-close aria-label="close">×</button>
      <nav class="mobile-drawer-nav" aria-label="mobile navigation">
        <a href={base}>{t.nav_home}</a>
        <a href={`${base}textbook/`}>{t.nav_textbook}</a>
        <a href={`${base}courses/`}>{t.nav_courses}</a>
        <a href={`${base}concepts/`}>{t.nav_concepts}</a>
        <a href={`${base}about/`}>{t.nav_about}</a>
      </nav>
      <div class="mobile-drawer-slot" id="mobile-drawer-slot"></div>
    </aside>
  </div>
  <main>
    <slot />
  </main>
  <footer>
    <small>Generated by video-to-notebook</small>
  </footer>
  <script is:inline>
    (function () {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        document.documentElement.classList.toggle('light', !isDark);
        try { localStorage.setItem('cm-theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    })();

    // Language toggle — navigates to the sibling deployment (/ ↔ /en/)
    // preserving the current sub-path when possible.
    (function () {
      const btn = document.getElementById('lang-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const current = btn.dataset.currentLang || 'zh';
        const path = window.location.pathname;
        const search = window.location.search + window.location.hash;
        // base is something like "/video-to-notebook/" or "/" locally
        const base = (document.querySelector('base')?.getAttribute('href')) || '/';

        // Strip the base path to get the sub-path within the site
        let sub = path.startsWith(base) ? path.slice(base.length) : path.replace(/^\//, '');

        let target;
        if (current === 'en') {
          // We're on en site. Strip leading 'en/' if present (it shouldn't be
          // — en build has its own base). Go to zh site at base ../ minus en/
          // Simplest: navigate to the en-base's parent + sub-path
          // base ends with /en/, parent is base without that segment
          const parentBase = base.replace(/en\/$/, '');
          target = parentBase + sub + search;
        } else {
          // We're on zh site. Append 'en/' to current base
          target = base + 'en/' + sub + search;
        }
        window.location.href = target;
      });
    })();

    (function () {
      const toggle = document.getElementById('nav-mobile-toggle');
      const drawer = document.getElementById('mobile-drawer');
      if (!toggle || !drawer) return;
      const open = () => {
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.classList.add('open'));
        toggle.setAttribute('aria-expanded', 'true');
        const slot = document.getElementById('mobile-drawer-slot');
        const sidebar = document.querySelector('.textbook-nav');
        if (slot && sidebar && !slot.dataset.populated) {
          slot.innerHTML = '';
          slot.appendChild(sidebar.cloneNode(true));
          slot.dataset.populated = '1';
        }
      };
      const close = () => {
        drawer.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        setTimeout(() => { drawer.hidden = true; }, 250);
      };
      toggle.addEventListener('click', open);
      drawer.querySelectorAll('[data-drawer-close]').forEach(el => el.addEventListener('click', close));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    })();
  </script>
  <script type="module">
    if (window.location.pathname !== undefined) {
      import("/_pagefind/pagefind-ui.js").then(({ PagefindUI }) => {
        new PagefindUI({ element: "#pagefind-search" });
      }).catch(() => {
        const el = document.getElementById("pagefind-search");
        if (el) el.innerHTML = '<input type="search" placeholder="Search (build first)…" />';
      });
    }
  </script>
  <script type="module">
    import katex from "https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.mjs";

    function renderInlineMath() {
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const matches = [];
      let node;
      while (node = walker.nextNode()) {
        const text = node.nodeValue;
        if (!text || !text.includes('$')) continue;
        const re = /\$\$(.+?)\$\$|\$([^\$\n]+?)\$/gs;
        if (re.test(text)) {
          re.lastIndex = 0;
          matches.push(node);
        }
      }
      for (const n of matches) {
        const text = n.nodeValue;
        const frag = document.createDocumentFragment();
        const re = /\$\$(.+?)\$\$|\$([^\$\n]+?)\$/gs;
        let last = 0;
        let m;
        while ((m = re.exec(text)) !== null) {
          if (m.index > last) {
            frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          }
          const span = document.createElement('span');
          const tex = m[1] || m[2];
          const isBlock = !!m[1];
          try {
            katex.render(tex, span, { displayMode: isBlock, throwOnError: false });
          } catch (e) {
            span.textContent = (isBlock ? '$$' : '$') + tex + (isBlock ? '$$' : '$');
          }
          frag.appendChild(span);
          last = re.lastIndex;
        }
        if (last < text.length) {
          frag.appendChild(document.createTextNode(text.slice(last)));
        }
        n.parentNode.replaceChild(frag, n);
      }
    }
    renderInlineMath();
  </script>
</body>
</html>
