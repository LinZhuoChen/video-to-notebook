---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · course-merger</title>
</head>
<body>
  <header>
    <nav>
      <a href="/">Home</a>
      <a href="/courses/">Courses</a>
      <a href="/concepts/">Concepts</a>
      <a href="/about/">About</a>
    </nav>
    <div id="pagefind-search"></div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <small>Generated by course-merger</small>
  </footer>
  <script type="module">
    // Pagefind UI is only available after `npm run build` (not dev server)
    if (window.location.pathname !== undefined) {
      import("/_pagefind/pagefind-ui.js").then(({ PagefindUI }) => {
        new PagefindUI({ element: "#pagefind-search" });
      }).catch(() => {
        // pagefind not available in dev mode - replace with plain input
        const el = document.getElementById("pagefind-search");
        if (el) el.innerHTML = '<input type="search" placeholder="Search (build first)…" style="padding:0.4rem 0.8rem;border:1px solid #ccc;border-radius:4px;min-width:200px;" />';
      });
    }
  </script>
</body>
</html>
