---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · course-merger</title>
  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+Pro:wght@400;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css">
  <script is:inline>
    (function () {
      try {
        const stored = localStorage.getItem('cm-theme');
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : sysDark;
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.toggle('light', !isDark);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <a class="site-logo" href="/">
      <span class="site-logo-mark">cm</span>
      <span class="site-logo-text">course<span class="site-logo-sep">-</span>merger</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/textbook/">教材</a>
      <a href="/courses/">课程</a>
      <a href="/concepts/">概念</a>
      <a href="/about/">关于</a>
    </nav>
    <div class="site-actions">
      <div id="pagefind-search" class="site-search"></div>
      <button class="theme-toggle" id="theme-toggle" aria-label="切换主题" title="切换主题">
        <svg class="icon-light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="icon-dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="nav-mobile-toggle" id="nav-mobile-toggle" aria-label="打开导航" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </header>
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <div class="mobile-drawer-backdrop" data-drawer-close></div>
    <aside class="mobile-drawer-panel">
      <button class="mobile-drawer-close" data-drawer-close aria-label="关闭">×</button>
      <nav class="mobile-drawer-nav" aria-label="移动导航">
        <a href="/">首页</a>
        <a href="/textbook/">教材</a>
        <a href="/courses/">课程</a>
        <a href="/concepts/">概念</a>
        <a href="/about/">关于</a>
      </nav>
      <div class="mobile-drawer-slot" id="mobile-drawer-slot"></div>
    </aside>
  </div>
  <main>
    <slot />
  </main>
  <footer>
    <small>Generated by course-merger</small>
  </footer>
  <script is:inline>
    (function () {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        document.documentElement.classList.toggle('light', !isDark);
        try { localStorage.setItem('cm-theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    })();

    (function () {
      const toggle = document.getElementById('nav-mobile-toggle');
      const drawer = document.getElementById('mobile-drawer');
      if (!toggle || !drawer) return;
      const open = () => {
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.classList.add('open'));
        toggle.setAttribute('aria-expanded', 'true');
        const slot = document.getElementById('mobile-drawer-slot');
        const sidebar = document.querySelector('.textbook-nav');
        if (slot && sidebar && !slot.dataset.populated) {
          slot.innerHTML = '';
          slot.appendChild(sidebar.cloneNode(true));
          slot.dataset.populated = '1';
        }
      };
      const close = () => {
        drawer.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        setTimeout(() => { drawer.hidden = true; }, 250);
      };
      toggle.addEventListener('click', open);
      drawer.querySelectorAll('[data-drawer-close]').forEach(el => el.addEventListener('click', close));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    })();
  </script>
  <script type="module">
    if (window.location.pathname !== undefined) {
      import("/_pagefind/pagefind-ui.js").then(({ PagefindUI }) => {
        new PagefindUI({ element: "#pagefind-search" });
      }).catch(() => {
        const el = document.getElementById("pagefind-search");
        if (el) el.innerHTML = '<input type="search" placeholder="Search (build first)…" />';
      });
    }
  </script>
  <script type="module">
    import katex from "https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.mjs";

    function renderInlineMath() {
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const matches = [];
      let node;
      while (node = walker.nextNode()) {
        const text = node.nodeValue;
        if (!text || !text.includes('$')) continue;
        const re = /\$\$(.+?)\$\$|\$([^\$\n]+?)\$/gs;
        if (re.test(text)) {
          re.lastIndex = 0;
          matches.push(node);
        }
      }
      for (const n of matches) {
        const text = n.nodeValue;
        const frag = document.createDocumentFragment();
        const re = /\$\$(.+?)\$\$|\$([^\$\n]+?)\$/gs;
        let last = 0;
        let m;
        while ((m = re.exec(text)) !== null) {
          if (m.index > last) {
            frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          }
          const span = document.createElement('span');
          const tex = m[1] || m[2];
          const isBlock = !!m[1];
          try {
            katex.render(tex, span, { displayMode: isBlock, throwOnError: false });
          } catch (e) {
            span.textContent = (isBlock ? '$$' : '$') + tex + (isBlock ? '$$' : '$');
          }
          frag.appendChild(span);
          last = re.lastIndex;
        }
        if (last < text.length) {
          frag.appendChild(document.createTextNode(text.slice(last)));
        }
        n.parentNode.replaceChild(frag, n);
      }
    }
    renderInlineMath();
  </script>
</body>
</html>
