---
import Base from '../../layouts/Base.astro';

let chapters: any[] = [];
try {
  const data = await import('../../content/textbook/curriculum.json');
  chapters = (data.default || data).chapters || [];
} catch (e) {
  chapters = [];
}

const byModule = new Map<string, any[]>();
for (const ch of chapters) {
  if (!byModule.has(ch.module)) byModule.set(ch.module, []);
  byModule.get(ch.module)!.push(ch);
}

const total = chapters.length;
const done = chapters.filter(c => c.status === 'synthesized').length;
---
<Base title="教材目录">
  <div class="toc-page">
    <header class="toc-header">
      <div class="toc-eyebrow">course-merger textbook</div>
      <h1 class="toc-title">教材目录</h1>
      {total > 0 && (
        <p class="toc-stats">
          <strong>{done}</strong> / {total} 章已生成
          <span class="toc-progress-track"><span class="toc-progress-fill" style={`width:${(done * 100 / total)}%`}></span></span>
        </p>
      )}
    </header>

    {chapters.length === 0 && (
      <div class="toc-empty">
        <p>暂无课程内容。</p>
        <p class="toc-help">先运行 <code>course-merger curriculum --apply-results &lt;file&gt;</code> 设计目录，再运行 <code>course-merger synthesize</code> 生成章节。</p>
      </div>
    )}

    {Array.from(byModule.entries()).map(([module, items], moduleIdx) => (
      <section class="toc-module">
        <div class="toc-module-header">
          <span class="toc-module-num">Module {moduleIdx + 1}</span>
          <h2 class="toc-module-title">{module}</h2>
        </div>
        <ol class="toc-chapter-list">
          {items.map(ch => (
            <li class:list={['toc-chapter', ch.status === 'synthesized' ? 'done' : 'planned']}>
              <div class="toc-chapter-num">{ch.order_idx}</div>
              <div class="toc-chapter-body">
                {ch.status === 'synthesized' ? (
                  <a class="toc-chapter-link" href={`/textbook/${ch.order_idx}/`}>
                    <h3 class="toc-chapter-title">{ch.title}</h3>
                    <p class="toc-chapter-blurb">{ch.blurb}</p>
                  </a>
                ) : (
                  <div class="toc-chapter-disabled">
                    <h3 class="toc-chapter-title">{ch.title} <span class="toc-pending">待生成</span></h3>
                    <p class="toc-chapter-blurb">{ch.blurb}</p>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .toc-page { max-width: 820px; margin-inline: auto; }

  .toc-header { margin-bottom: 3.5rem; }
  .toc-eyebrow {
    font-size: 0.82em;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .toc-title {
    font-family: var(--font-serif);
    font-size: 3.2em;
    font-weight: 700;
    margin-block: 0.2rem 1rem;
    letter-spacing: -0.02em;
  }
  .toc-stats {
    display: flex; align-items: center; gap: 1rem;
    color: var(--text-muted);
    font-size: 0.95em;
    font-variant-numeric: tabular-nums;
  }
  .toc-stats strong { color: var(--accent); font-weight: 700; }
  .toc-progress-track {
    flex: 1;
    max-width: 200px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .toc-progress-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
  }

  .toc-empty {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .toc-help { color: var(--text-muted); font-size: 0.95em; margin-top: 0.5rem; }

  .toc-module { margin-block: 3rem; }
  .toc-module-header {
    display: flex; align-items: baseline; gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--text);
    margin-bottom: 0.8rem;
  }
  .toc-module-num {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .toc-module-title {
    font-family: var(--font-serif);
    font-size: 1.5em;
    font-weight: 600;
    margin: 0;
    color: var(--text);
  }

  .toc-chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-chapter {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .toc-chapter:last-child { border-bottom: 0; }
  .toc-chapter-num {
    font-family: var(--font-serif);
    font-size: 2.5em;
    font-weight: 600;
    line-height: 1;
    color: var(--text-faint);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .toc-chapter.done .toc-chapter-num { color: var(--accent); }

  .toc-chapter-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }
  .toc-chapter-link:hover .toc-chapter-title { color: var(--accent); }

  .toc-chapter-title {
    font-family: var(--font-serif);
    font-size: 1.35em;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.3rem;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .toc-chapter-blurb {
    color: var(--text-muted);
    font-size: 0.95em;
    margin: 0;
    line-height: 1.55;
  }

  .toc-pending {
    display: inline-block;
    font-size: 0.55em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    background: var(--surface-soft);
    padding: 0.2em 0.5em;
    border-radius: 3px;
    vertical-align: middle;
    margin-left: 0.5rem;
    font-family: var(--font-sans);
  }
  .toc-chapter.planned .toc-chapter-title { color: var(--text-muted); }
  .toc-chapter.planned .toc-chapter-blurb { color: var(--text-faint); }

  @media (max-width: 700px) {
    .toc-title { font-size: 2.2em; }
    .toc-chapter { grid-template-columns: 3rem 1fr; gap: 0.7rem; }
    .toc-chapter-num { font-size: 2em; }
  }
</style>
