---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, currentLanguage } from '../i18n';

const courses = await getCollection('course');
const concepts = await getCollection('concept');

let chapters: any[] = [];
try {
  const data = await import('../content/textbook/curriculum.json');
  chapters = (data.default || data).chapters || [];
} catch (e) {
  chapters = [];
}
const synthesizedCount = chapters.filter((c: any) => c.status === 'synthesized').length;
const ctaHeading = currentLanguage === 'en' ? '📖 Start reading' : '📖 开始阅读';
const ctaProgressLabel = currentLanguage === 'en' ? 'generated' : '已生成';
const ctaChapterLabel = currentLanguage === 'en' ? 'chapters' : '章';
const resourcesHeading = currentLanguage === 'en' ? 'Source resources (lookup)' : '原始资源（lookup）';
---
<Base title="Home">
  <h1>video-to-notebook</h1>
  <p class="lead">{t.index_lead}</p>

  {synthesizedCount > 0 && (
    <section class="cta">
      <h2>{ctaHeading}</h2>
      <p>{currentLanguage === 'en'
          ? <>Generated <strong>{synthesizedCount}/{chapters.length}</strong> chapters.</>
          : <>已生成 <strong>{synthesizedCount}/{chapters.length}</strong> 章。</>
      }</p>
      <p><a class="primary-cta" href="/textbook/">{t.index_cta_open_textbook}</a></p>
    </section>
  )}

  <h2>{resourcesHeading}</h2>
  <p>{t.index_stats(courses.length, concepts.length)}</p>
  <p>
    <a href="/courses/">{t.index_browse_by_course}</a> · <a href="/concepts/">{t.index_browse_by_concept}</a>
  </p>
</Base>

<style>
  .lead { color: #555; font-size: 1.1em; }
  .cta { background: #f0f9f4; padding: 1.5rem; border-radius: 8px; border-left: 4px solid #0b5; margin: 2rem 0; }
  .cta h2 { margin-top: 0; }
  .primary-cta { display: inline-block; padding: 0.6rem 1.2rem; background: #0b5; color: #fff; text-decoration: none; border-radius: 4px; font-weight: 600; }
</style>
